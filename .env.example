# Frontend
# Deixe vazio em dev (o Vite faz proxy de /api → :3001). Em produção, aponte para a URL do backend.
VITE_API_URL=

# Backend
PORT=3001

# OpenRouter API (for AI analysis)
# Get your API key from: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-YOUR_API_KEY_HERE
# Opcional: fixa um modelo (tentado primeiro). Sem isso, o backend descobre sozinho os
# modelos gratuitos disponíveis em https://openrouter.ai/api/v1/models (cache de 1h).
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
